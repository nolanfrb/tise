{
  "sourceLanguage" : "fr",
  "strings" : {
    "%@ lit à voix haute : %@" : {
      "comment" : "Line above a « They're a 10 but » card: the first %@ is the reader's name, the second the French opening of the card, kept as content.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reads out loud: %@"
          }
        }
      }
    },
    "%lld tises" : {
      "comment" : "Sips at stake on a card in Never Have I Ever: those who have done it drink this many. « Tise » is the app's sip unit.",
