    "Les cartes n'ont pas chargé" : {
      "comment" : "Error shown when the card bank cannot be read.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cards didn't load"
          }
        }
      }
    },
    "Lisez la phrase à voix haute. Tous ceux qui l'ont déjà fait boivent les tises de la carte, puis racontent. Une tise d'eau, ça compte aussi." : {
      "comment" : "Rules of Never Have I Ever, shown in an alert.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the line out loud. Everyone who has done it drinks the sips on the card, then tells the story. A sip of water counts too."
          }
        }
      }
    },
    "Personne à table pour l'instant" : {
      "comment" : "Title of the roster page before any player is added.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody at the table yet"
          }
        }
      }
    },
    "Pimenté et osé, réservé aux 18 ans et plus" : {
      "comment" : "Description of the Hot level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spicy and daring, for ages 18 and up"
          }
        }
      }
    },
    "Plus de carte pour cette table" : {
