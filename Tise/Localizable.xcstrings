{
  "sourceLanguage" : "fr",
  "strings" : {
    "%lld tises" : {
      "comment" : "Sips at stake on a card in Never Have I Ever: those who have done it drink this many. « Tise » is the app's sip unit.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld sip"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld sips"
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tise"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld tises"
                }
              }
            }
          }
        }
      }
    },
    "Action" : {
      "comment" : "Button: the current player picks a dare.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare"
          }
        }
      }
    },
    "Action ou" : {
      "comment" : "First line of the Truth or Dare tile on the home screen, above the big colored word.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth or"
          }
        }
      }
    },
    "Action ou Vérité" : {
      "comment" : "Name of the Truth or Dare game, used as a screen title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth or Dare"
          }
        }
      }
    },
    "Action ou vérité ?" : {
      "comment" : "Asked to the player whose turn it is, under their name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Truth or dare?"
          }
        }
      }
    },
    "Action pour %@" : {
      "comment" : "Line above a dare card; %@ is the player's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dare for %@"
          }
        }
      }
    },
    "Ajoute encore %lld joueurs pour lancer la partie" : {
      "comment" : "Hint above the launch button while players are missing.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld more player to start the game"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Add %lld more players to start the game"
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ajoute encore %lld joueur pour lancer la partie"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ajoute encore %lld joueurs pour lancer la partie"
                }
              }
            }
          }
        }
      }
    },
    "Ajoute un joueur" : {
      "comment" : "Placeholder of the field where a player's name is typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a player"
          }
        }
      }
    },
    "Ajouter le joueur" : {
      "comment" : "Button that adds the typed player to the table.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add player"
          }
        }
      }
    },
    "Aléatoire" : {
      "comment" : "Level that mixes soft and hot cards.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Random"
          }
        }
      }
    },
    "Cartes jouées" : {
      "comment" : "Accessibility label of the progress bar of a party.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards played"
          }
        }
      }
    },
    "Chacun son tour, le joueur choisit Action ou Vérité. Une vérité se dit franchement, une action se fait jusqu'au bout. Tu refuses ? Tu bois les tises de la carte, sans discussion. Une tise d'eau, ça compte aussi." : {
      "comment" : "Rules of Truth or Dare, shown in an alert.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take turns picking Truth or Dare. A truth gets an honest answer, a dare gets done all the way. Refusing? Drink the sips on the card, no arguing. A sip of water counts too."
          }
        }
      }
    },
    "Change entre femme et homme" : {
      "comment" : "Accessibility hint of a player card: a tap switches the player's sex.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switches between woman and man"
          }
        }
      }
    },
    "Compris" : {
      "comment" : "Dismisses the rules alert.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got it"
          }
        }
      }
    },
    "Femme" : {
      "comment" : "Sex of a player: woman.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Woman"
          }
        }
      }
    },
    "Fun et bon enfant, pour chauffer la table" : {
      "comment" : "Description of the Soft level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light and friendly, to warm up the table"
          }
        }
      }
    },
    "Homme" : {
      "comment" : "Sex of a player: man.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man"
          }
        }
      }
    },
    "Hot" : {
      "comment" : "Name of the spicy, 18+ level.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hot"
          }
        }
      }
    },
    "Il faut au moins %lld joueurs pour lancer une partie." : {
      "comment" : "Footer of the roster while there are too few players.",
