        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You need at least %lld player to start a game."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You need at least %lld players to start a game."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
